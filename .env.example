# Copy to .env and adjust for your environment.

NODE_ENV=development
PORT=3000

# SQLite database file (ignored in tests, which use an in-memory DB).
DATABASE_STORAGE=./database.sqlite

# IMPORTANT: set a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins for the web client, or "*".
CORS_ORIGIN=*

# bcrypt cost factor.
BCRYPT_ROUNDS=10
